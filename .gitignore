# edge-functions/ 是 node tools/build.mjs 的生成物,但刻意入库:
# EdgeOne Makers 关联仓库后按"仓库根 = 站点根"找函数目录,放子目录就只能在控制台手动传 ZIP。
# 改了 cards/ 或 deno_index.ts 必须重跑 build,否则线上静默跑旧代码。

node_modules/
*.log

# render.mjs 的产物:由 Actions 渲染、经 Pages artifact 发布,不走 git。
# 提交它等于把"流水线会重建的东西"变成第二份真源,两边一旦漂移就没人知道该信谁。
dist-cards/
.test-cards/

# test/all.mjs 自己写的临时配置(跑完会删;留个兜底,免得断言中途炸了就把垃圾带进提交)
.render.test.json
.render.bad.json

# 站点根会被整仓当静态资源发布,密钥文件一旦被请求就是明文外泄。
# GITHUB_TOKEN 只允许待在平台变量里:EdgeOne 控制台 / wrangler secret / 进程环境。
.env
.env.*
.dev.vars
.dev.vars.local

# edgeone CLI 的本地状态目录,可能含 .token(平台令牌明文)。
# 本站点 outputDirectory 是 ".",整仓都是可请求的静态资源 —— 这条不是整洁问题,是防泄密。
.edgeone/
.ssh_deploy_key*
